{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=portfolio_db;Username=portfolio_user;Password=replace_with_env_secret"
  },
  "Jwt": {
    "Issuer": "Portfolio.API",
    "Audience": "Portfolio.Frontend",
    "Secret": "replace-with-64-char-secret-from-environment-variables"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
